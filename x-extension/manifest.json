{
  "manifest_version": 3,
  "name": "X Quick Comment",
  "version": "1.1.0",
  "description": "Adds a custom quick-comment option to X/Twitter post dropdown menus.",
  "permissions": [],
  "host_permissions": ["https://mini.fireshare.uk/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
