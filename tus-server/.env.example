# Optional video-processing service. Match the profile's cloudDrivePort to PORT.
PORT=3000

# Required only for private-drive uploads and other username-protected routes.
# Set this to the exact dTweet username allowed to use those routes.
# Tweet-video conversion and publishing through the app's IPFS endpoint do not
# require this setting. Leaving it unset keeps private-drive access disabled.
# AUTHORIZED_USERNAME=your_dtweet_username

# Optional local directory for network-drive browsing.
# NET_DISK=/path/to/your/network/disk
